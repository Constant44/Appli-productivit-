{
  "name": "cadence",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Cadence : planning de prépa (journée, semaine, mois, année), mode Focus, bilan hebdomadaire et quiz du test d'actu.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "build:ipad": "tsc --noEmit -p . && vite build --mode artifact && node scripts/make-artifact.mjs"
  },
  "dependencies": {
    "express": "^4.22.3",
    "pawnote": "^1.6.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vite-plugin-singlefile": "^2.3.2",
    "vitest": "^3.2.7"
  }
}
